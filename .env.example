# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- MinIO / S3-compatible storage (local) ---
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mlflow-artifacts

# --- Model quality gate ---
# Minimum F1 score required to promote a model to production
MIN_F1_THRESHOLD=0.80

# --- AWS (production only, leave blank for local runs) ---
# AWS_REGION=eu-west-1
# ECR_URI=123456789.dkr.ecr.eu-west-1.amazonaws.com
